MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=nexusapp
# Replace with a randomly generated secret of at least 50 characters.
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DEFAULT_FROM_EMAIL=your-account@gmail.com
FRONTEND_URL=http://localhost:5173
# Gmail requires 2-Step Verification and an App Password for SMTP.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
